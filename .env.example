# VyaparSarathi — Phase 1 configuration.
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real values.
# All variables are read via src/vyaparsarathi/config/settings.py (prefix: VYAPAR_).

# --- Overpass (OpenStreetMap business discovery) ---
VYAPAR_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Comma-separated fallback endpoints, tried in order on transient failure:
VYAPAR_OVERPASS_MIRRORS=https://overpass.kumi.systems/api/interpreter,https://z.overpass-api.de/api/interpreter
VYAPAR_OVERPASS_QUERY_TIMEOUT_S=60

# --- Nominatim (geocoding) ---
VYAPAR_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim public policy: <= 1 request/second, descriptive User-Agent required.
VYAPAR_NOMINATIM_MIN_INTERVAL_S=1.0

# --- AGMARKNET (data.gov.in wholesale mandi price signal) ---
VYAPAR_AGMARKNET_BASE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
# Register your own key at https://data.gov.in — never commit a real key here.
# Unset = "not configured"; the shared public demo key is never substituted.
# VYAPAR_AGMARKNET_API_KEY=
VYAPAR_AGMARKNET_MAX_COMMODITIES_PER_QUERY=3
VYAPAR_AGMARKNET_RESULT_LIMIT=50

# --- HTTP behaviour (shared) ---
VYAPAR_HTTP_TIMEOUT_S=60
VYAPAR_HTTP_MAX_RETRIES=3
VYAPAR_HTTP_BACKOFF_BASE_S=2.0
# REQUIRED for the public Nominatim instance: put a real, working contact here.
# A generic/placeholder value (e.g. an example.org address, or the shipped
# default) commonly gets rejected with HTTP 403 by Nominatim's usage policy.
VYAPAR_USER_AGENT=VyaparSarathi/0.1 (SIH26091; contact: you@example.org)

# --- Caching ---
VYAPAR_CACHE_ENABLED=true
VYAPAR_CACHE_DIR=.cache
VYAPAR_CACHE_TTL_S=604800

# --- Discovery limits ---
VYAPAR_MAX_RADIUS_M=25000

# --- Phase 2C: local demand signals ---
# Pre-joined Census 2011 village extract (CSV or .csv.gz). See
# data/demand/SOURCES.md. A missing file degrades to "no population data".
VYAPAR_CENSUS_VILLAGES_PATH=data/demand/census2011_villages.csv.gz

# --- Phase 5: knowledge / evidence corpus ---
# Directory holding documents.jsonl, chunks.jsonl(.gz), parameters.csv and
# manifest.json. See data/knowledge/SOURCES.md. A missing directory degrades
# to "no evidence available", never a crash.
VYAPAR_KNOWLEDGE_CORPUS_DIR=data/knowledge
# How many RetrievedPassage objects a query may return for display/citation.
VYAPAR_KNOWLEDGE_MAX_PASSAGES=8

# --- Deduplication thresholds (see CLAUDE.md §9) ---
VYAPAR_DEDUP_NAME_SIMILARITY_MERGE=87
VYAPAR_DEDUP_NAME_SIMILARITY_UNCERTAIN=75
VYAPAR_DEDUP_DISTANCE_MERGE_M=120
VYAPAR_DEDUP_DISTANCE_UNCERTAIN_M=200

# --- Persistence ---
# SQLite by default. For Postgres use e.g.
#   postgresql+psycopg://user:pass@localhost:5432/vyaparsarathi
VYAPAR_DB_URL=sqlite:///vyaparsarathi.sqlite3

# --- Logging ---
VYAPAR_LOG_LEVEL=INFO

# --- Phase 6: LLM orchestration ---
# llm_enabled=false is a fully supported mode: the whole advisory pipeline
# runs and answers deterministically with no API key at all (CLAUDE.md §3.1).
# Set true only once ONE of the two provider shapes below is configured.
VYAPAR_LLM_ENABLED=false
# Two ways to point the conversational layer at a model (app/runtime.py::
# build_llm_provider picks between them):
#   1. VYAPAR_LLM_BASE_URL set -> a provider-agnostic HTTP shim (a thin
#      adapter, not a vendor SDK; CLAUDE.md §4.1). Must not embed a
#      credential in the query string.
#   2. VYAPAR_LLM_BASE_URL blank + VYAPAR_LLM_API_KEY set -> a Gemini-native
#      provider (llm/gemini_provider.py, role="conversation") using the same
#      VYAPAR_LLM_MODEL / VYAPAR_LLM_TIMEOUT_S / retry fields below. This key
#      is SEPARATE from the Phase 5 extractor/verifier keys further down.
VYAPAR_LLM_BASE_URL=
VYAPAR_LLM_MODEL=
# Never commit a real key. Set this only in a local, git-ignored .env.
# VYAPAR_LLM_API_KEY=
VYAPAR_LLM_TIMEOUT_S=30.0
VYAPAR_LLM_MAX_RETRIES=2
VYAPAR_LLM_BACKOFF_BASE_S=1.0
VYAPAR_LLM_MAX_OUTPUT_TOKENS=4096
VYAPAR_LLM_TEMPERATURE=0.2
VYAPAR_LLM_PROMPT_VERSION=v1
# Opt-in, default false: LLM-authored reply phrasing over already-computed
# facts, swapped in only when conversation/grounding.py accepts it (never a
# prerequisite for safe extraction). See llm/reply_authoring.py.
VYAPAR_LLM_REPLY_AUTHORING_ENABLED=false

# --- Phase 5: knowledge extraction (dual-Gemini extractor/verifier gate) ---
# Offline ETL only (scripts/build_parameter_registry.py extract) — never on
# the request path. Two INDEPENDENT models/keys so a disagreement between
# them is meaningful, not the same model contradicting itself. See
# docs/phase-5.md for the full gate this replaces a human signature with.
# VYAPAR_GEMINI_EXTRACTOR_API_KEY=
VYAPAR_GEMINI_EXTRACTOR_MODEL=gemini-3.6-flash
# VYAPAR_GEMINI_VERIFIER_API_KEY=
VYAPAR_GEMINI_VERIFIER_MODEL=gemini-3.5-flash
VYAPAR_GEMINI_TIMEOUT_S=60.0
VYAPAR_GEMINI_MAX_RETRIES=3
VYAPAR_GEMINI_BACKOFF_BASE_S=2.0

# --- Phase 7: WhatsApp channel (NOT WIRED YET) ---
# `channels/whatsapp/` is a provider-neutral boundary only: it maps a neutral
# webhook dict to a MessageRequest and an AdvisoryReply back to text bubbles,
# and drives AdvisoryService. No live provider, no SDK, and NO settings are
# read yet — `Settings` has no WhatsApp fields. Before a real provider is
# connected, a decision + these credentials will be needed (added here then):
#   VYAPAR_WHATSAPP_PROVIDER=            # meta_cloud | twilio | ... (choose one)
#   VYAPAR_WHATSAPP_VERIFY_TOKEN=        # webhook subscription verification
#   VYAPAR_WHATSAPP_APP_SECRET=          # inbound payload signature check
#   VYAPAR_WHATSAPP_ACCESS_TOKEN=        # outbound send auth (provider bearer)
#   VYAPAR_WHATSAPP_PHONE_NUMBER_ID=     # the business number sending replies
#   VYAPAR_WHATSAPP_API_BASE_URL=        # provider send endpoint (no credential in the URL)
