# VyaparSarathi — Phase 1 configuration.
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real values.
# All variables are read via src/vyaparsarathi/config/settings.py (prefix: VYAPAR_).

# --- Overpass (OpenStreetMap business discovery) ---
VYAPAR_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Comma-separated fallback endpoints, tried in order on transient failure:
VYAPAR_OVERPASS_MIRRORS=https://overpass.kumi.systems/api/interpreter,https://z.overpass-api.de/api/interpreter
VYAPAR_OVERPASS_QUERY_TIMEOUT_S=60

# --- Nominatim (geocoding) ---
VYAPAR_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim public policy: <= 1 request/second, descriptive User-Agent required.
VYAPAR_NOMINATIM_MIN_INTERVAL_S=1.0

# --- HTTP behaviour (shared) ---
VYAPAR_HTTP_TIMEOUT_S=60
VYAPAR_HTTP_MAX_RETRIES=3
VYAPAR_HTTP_BACKOFF_BASE_S=2.0
# Put a real contact address here so OSM admins can reach you:
VYAPAR_USER_AGENT=VyaparSarathi/0.1 (SIH26091; contact: you@example.org)

# --- Caching ---
VYAPAR_CACHE_ENABLED=true
VYAPAR_CACHE_DIR=.cache
VYAPAR_CACHE_TTL_S=604800

# --- Discovery limits ---
VYAPAR_MAX_RADIUS_M=25000

# --- Phase 2C: local demand signals ---
# Pre-joined Census 2011 village extract (CSV or .csv.gz). See
# data/demand/SOURCES.md. A missing file degrades to "no population data".
VYAPAR_CENSUS_VILLAGES_PATH=data/demand/census2011_villages.csv.gz

# --- Deduplication thresholds (see CLAUDE.md §9) ---
VYAPAR_DEDUP_NAME_SIMILARITY_MERGE=87
VYAPAR_DEDUP_NAME_SIMILARITY_UNCERTAIN=75
VYAPAR_DEDUP_DISTANCE_MERGE_M=120
VYAPAR_DEDUP_DISTANCE_UNCERTAIN_M=200

# --- Persistence ---
# SQLite by default. For Postgres use e.g.
#   postgresql+psycopg://user:pass@localhost:5432/vyaparsarathi
VYAPAR_DB_URL=sqlite:///vyaparsarathi.sqlite3

# --- Logging ---
VYAPAR_LOG_LEVEL=INFO
